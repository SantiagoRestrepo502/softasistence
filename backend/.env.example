# Variables de Entorno - Backend

# Entorno de ejecución
NODE_ENV=production

# Puerto del servidor
PORT=3000

# Configuración de MySQL
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=asistencia
MYSQL_CONNECTION_LIMIT=10

# Nota: En producción, cambia las credenciales por unas seguras
